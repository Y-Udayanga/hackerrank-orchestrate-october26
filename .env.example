# Supply credentials in your environment. Never put real credentials in this file.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API=interactions
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=3
# Optional verified prices in USD per million tokens; blank means unknown.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
